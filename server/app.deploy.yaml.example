runtime: nodejs22
env: standard
instance_class: F1

# Skopiuj ten plik do app.deploy.yaml (ignorowany przez Git).
env_variables:
  PUBLIC_APP_URL: "https://anzan-web.ew.r.appspot.com"
  # Tylko awaryjny bootstrap. Normalnie ownera zaprasza npm run invite:owner.
  ALLOW_OWNER_BOOTSTRAP: "false"

automatic_scaling:
  min_instances: 0
  max_instances: 1
  target_cpu_utilization: 0.65
